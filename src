local function FindBaitEggSlot()
    local areaFolder = workspace:FindFirstChild("AreaEggSlotsClient")
    if not areaFolder then return nil end

    if baitSlotTargetName and #baitSlotTargetName > 0 then
        local exact = areaFolder:FindFirstChild(baitSlotTargetName)
        if exact then return exact end
    end

    local fallbackExact = areaFolder:FindFirstChild("FirstAreaEgg_11569730011_5962409_Forest:Slot_001")
    if fallbackExact then return fallbackExact end

    for _, child in ipairs(areaFolder:GetChildren()) do
        if string.find(child.Name, "Forest:Slot_001") or string.find(child.Name, "Slot_001") then
            return child
        end
    end

    for _, child in ipairs(areaFolder:GetChildren()) do
        if string.find(child.Name, "001") then
            return child
        end
    end

    return areaFolder:GetChildren()[1]
