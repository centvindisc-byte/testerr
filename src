-- ==============================
-- AUTO FARM LOGIC
-- ==============================
local function stopAutoFarm()
    autoFarming = false
end

local function runAutoFarm()
    if autoFarming then return end
    autoFarming = true
    
    -- Assign base position right as auto farm starts
    if not cachedBasePosition and charCache.hrp then
        cachedBasePosition = charCache.hrp.Position
    end
    
    while autoFarming do
        if not charCache.hrp or not charCache.humanoid or charCache.humanoid.Health <= 0 then
            task.wait(1)
        else
            local basePos = getBasePosition()
            if not basePos then 
                task.wait(1)
            else
                local sortPos = (autoFarmSortMode == "Closest" and charCache.hrp.Position) or basePos
                local eggList = getAllEggSlotsSorted(sortPos, autoFarmSortMode)
                if #eggList == 0 then 
                    task.wait(1)
                else
                    local eggData = eggList[1]
                    if eggData and eggData.Part and eggData.Folder then
                        -- 1. Walk to the egg
                        walkToPosition(eggData.Part.Position)
                        
                        if autoFarming and charCache.hrp and charCache.humanoid and charCache.humanoid.Health > 0 then
                            enlargeHitbox(eggData.Part)
                            
                            -- 2. Grab the egg
                            invokeEggCarry(eggData.Folder)
                            
                            -- FIX: Wait a moment for the server to attach the egg to your character
                            task.wait(0.4) 
                            
                            -- 3. Walk back to your home base
                            walkToPosition(basePos)
                            
                            -- FIX: Wait briefly at the base so the game registers the egg dropping off
                            task.wait(0.2)
                        end
                    end
                end
            end
        end
        task.wait(0.5)
    end
end

