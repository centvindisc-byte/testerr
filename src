local function walkToPosition(targetPosition)
    local humanoid = charCache.humanoid
    local hrp = charCache.hrp
    if not hrp or not humanoid then return end

    if autoFarming and autoFarmWalkSpeedEnabled then humanoid.WalkSpeed = autoFarmWalkSpeed end
    humanoid:MoveTo(targetPosition)

    local timeout = 30
    local waitTime = 0
    while waitTime < timeout do
        if not autoFarming then 
            if charCache.humanoid and charCache.hrp then
                charCache.humanoid:MoveTo(charCache.hrp.Position)
            end
            break 
        end
        
        -- Break if character died or respawned so we can re-fetch
        if not charCache.humanoid or charCache.humanoid.Health <= 0 or not charCache.hrp then break end
        if charCache.hrp ~= hrp then break end

        if (hrp.Position - targetPosition).Magnitude < 5 then break end
        
        -- Repeatedly call MoveTo to bypass the 8-second Roblox timeout
        charCache.humanoid:MoveTo(targetPosition)
        
        task.wait(0.1)
        waitTime = waitTime + 0.1
    end
end

