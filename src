local function FastWalk(targetPos, timeout, speedMultiplier)
    local chr = LocalPlayer.Character
    if not chr then return false end
    local hrp = chr:FindFirstChild("HumanoidRootPart")
    local hum = chr:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return false end

    local baseSpeed = math.max(1, tonumber(stealSpeed) or 500)
    local start = os.clock()
    local maxTime = timeout or 60
    local arrived = false
    local failed = false
    local conn

    local function finish(ok)
        if conn then
            conn:Disconnect()
            conn = nil
        end
        if not ok then failed = true end
    end

    conn = RunService.Heartbeat:Connect(function(dt)
        if HUB.dead or failed or arrived then
            finish(arrived)
            return
        end
        if not (chr.Parent and hrp.Parent and hum.Parent) then
            finish(false)
            return
        end
        if hum.Health <= 0 or hum.Sit then
            finish(false)
            return
        end
        if os.clock() - start > maxTime then
            finish(false)
            return
        end

        local offset = targetPos - hrp.Position
        local horizontal = Vector3.new(offset.X, 0, offset.Z)
        local distance = horizontal.Magnitude
        if distance <= 3 then
            arrived = true
            finish(true)
            return
        end

        local direction = horizontal.Unit
        pcall(function() hum:Move(direction, false) end)

        local elapsed = os.clock() - start
        local speed = baseSpeed
        if elapsed < TAKEOFF_TIME then
            speed = baseSpeed * (tonumber(speedMultiplier) or TAKEOFF_MULTIPLIER)
        end
        local step = direction * speed * dt
        hrp.CFrame = hrp.CFrame + step
        local velocity = hrp.AssemblyLinearVelocity
        hrp.AssemblyLinearVelocity = Vector3.new(0, velocity.Y, 0)
    end)

    while not (arrived or failed or HUB.dead) do
        if not (chr.Parent and hrp.Parent and hum.Parent) then
            finish(false)
            break
        end
        task.wait(0.1)
    end

    if not arrived then finish(false) end
    return arrived
end

