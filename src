local function GetSlotPosition(slotFolder)
    if not slotFolder then return nil end
    local p = slotFolder:FindFirstChild("Part_Union") or slotFolder:FindFirstChildWhichIsA("BasePart") or slotFolder.PrimaryPart
    if p then return p.Position end
    for _, d in ipairs(slotFolder:GetDescendants()) do
        if d:IsA("BasePart") then return d.Position end
    end
    return nil
end

local function FindTargetEgg(baitFolder)
    local baitName = baitFolder and baitFolder.Name
    local areaFolder = workspace:FindFirstChild("AreaEggSlotsClient")
    local mypos = (charCache and charCache.hrp and charCache.hrp.Position) or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character.HumanoidRootPart.Position) or Vector3.zero

    -- 1. Try server snapshot if available
    if NETMAP and NETMAP.Eggs and NETMAP.Eggs.REQUEST_AREA_EGG_SNAPSHOT then
        local ok, snap = pcall(Network.Invoke, NETMAP.Eggs.REQUEST_AREA_EGG_SNAPSHOT)
        if ok and type(snap) == "table" and type(snap.Records) == "table" then
            local best, bestScore = nil, math.huge
            local rareBest, rareScore = nil, math.huge

            for _, r in ipairs(snap.Records) do
                local isBait = (baitName and (r.Uid == baitName or string.find(r.Uid or "", "Slot_001"))) or (r.SlotKey and string.find(r.SlotKey, "Slot_001"))
                if not isBait and r.State == "Slot" and stealRaritySet[EggRarityId(r)] then
                    local d = (r.BottomCFrame.Position - mypos).Magnitude
                    local num = EggRarityNumber(r)
                    local score = d - num * 0.5
                    if score < bestScore then best, bestScore = r, score end
                    if rareHunterEnabled and num >= rareMinTier then
                        local rs = d - num * 0.5
                        if rs < rareScore then rareBest, rareScore = r, rs end
                    end
                end
            end
            if rareHunterEnabled and rareBest then best = rareBest end
            if best then
                local folder = nil
                if areaFolder then
                    folder = areaFolder:FindFirstChild(best.Uid)
                    if not folder then
                        for _, child in ipairs(areaFolder:GetChildren()) do
                            if child.Name == best.Uid or (best.SlotKey and string.find(child.Name, best.SlotKey)) then
                                folder = child
                                break
                            end
                        end
                    end
                end
                return {
                    Record = best,
                    Folder = folder,
                    Position = best.BottomCFrame.Position,
                    Uid = best.Uid,
                    Category = best.AssetCategory
                }
            end
        end
    end

    -- 2. Fallback to workspace.AreaEggSlotsClient folders
    if areaFolder then
        local candidates = {}
        for _, slotFolder in ipairs(areaFolder:GetChildren()) do
            if slotFolder ~= baitFolder and (not baitName or slotFolder.Name ~= baitName) and not string.find(slotFolder.Name, "Slot_001") then
                local partUnion = slotFolder:FindFirstChild("Part_Union") or slotFolder:FindFirstChildWhichIsA("BasePart")
                if partUnion then
                    local dist = (partUnion.Position - mypos).Magnitude
                    table.insert(candidates, {
                        Folder = slotFolder,
                        Part = partUnion,
                        Position = partUnion.Position,
                        Uid = slotFolder.Name,
                        Category = slotFolder.Name,
                        Distance = dist
                    })
                end
            end
        end

        if #candidates > 0 then
            table.sort(candidates, function(a, b)
                if autoFarmSortMode == "Farthest" then
                    return a.Distance > b.Distance
                else
                    return a.Distance < b.Distance
                end
            end)
            return candidates[1]
        end
    end

    return nil
end

local function WaitForChickenRagdoll(timeout)
    local chr = LocalPlayer.Character
    if not chr then return false end
    local hum = chr:FindFirstChildOfClass("Humanoid")
    if not hum then return false end

    local maxWait = timeout or ragdollTimeout or 7
    local triggered = false
    local bindable = Instance.new("BindableEvent")

    local function trigger()
        if not triggered then
            triggered = true
            bindable:Fire()
        end
    end

    local state = hum:GetState()
    if state == Enum.HumanoidStateType.Ragdoll 
       or state == Enum.HumanoidStateType.Physics 
       or state == Enum.HumanoidStateType.PlatformStanding 
       or state == Enum.HumanoidStateType.FallingDown 
       or hum.Sit 
       or hum.PlatformStand then
        return true
    end

    local conns = {}

    table.insert(conns, hum.StateChanged:Connect(function(old, new)
        if new == Enum.HumanoidStateType.Ragdoll 
           or new == Enum.HumanoidStateType.Physics 
           or new == Enum.HumanoidStateType.PlatformStanding 
           or new == Enum.HumanoidStateType.FallingDown then
            trigger()
        end
    end))

    table.insert(conns, hum:GetPropertyChangedSignal("Sit"):Connect(function()
        if hum.Sit then trigger() end
    end))

    table.insert(conns, hum:GetPropertyChangedSignal("PlatformStand"):Connect(function()
        if hum.PlatformStand then trigger() end
    end))

    table.insert(conns, chr.AttributeChanged:Connect(function(name)
        local val = chr:GetAttribute(name)
        if val == true and (string.find(name:lower(), "ragdoll") or string.find(name:lower(), "stun")) then
            trigger()
        end
    end))

    table.insert(conns, chr.ChildAdded:Connect(function(child)
        if string.find(child.Name:lower(), "ragdoll") then
            trigger()
        end
    end))

    task.spawn(function()
        local start = os.clock()
        while not triggered and not HUB.dead and (os.clock() - start) < maxWait do
            local s = hum:GetState()
            if s == Enum.HumanoidStateType.Ragdoll 
               or s == Enum.HumanoidStateType.Physics 
               or s == Enum.HumanoidStateType.PlatformStanding 
               or s == Enum.HumanoidStateType.FallingDown 
               or hum.Sit 
               or hum.PlatformStand then
                trigger()
                break
            end
            local hrp = chr:FindFirstChild("HumanoidRootPart")
            if hrp then
                for _, entity in ipairs(workspace:GetChildren()) do
                    if string.find(entity.Name:lower(), "chicken") and entity:IsA("Model") then
                        local primary = entity.PrimaryPart or entity:FindFirstChildWhichIsA("BasePart")
                        if primary and (primary.Position - hrp.Position).Magnitude < 7 then
                            task.wait(0.05)
                            trigger()
                            break
                        end
                    end
                end
            end
            task.wait(0.02)
        end
        if not triggered then
            bindable:Fire()
        end
    end)

    bindable.Event:Wait()

    for _, c in ipairs(conns) do
        pcall(function() c:Disconnect() end)
    end
    bindable:Destroy()

    return triggered
end

local function TweenToBase(targetPos, speed)
    local chr = LocalPlayer.Character
    if not chr then return false end
    local hrp = chr:FindFirstChild("HumanoidRootPart")
    local hum = chr:FindFirstChildOfClass("Humanoid")
    if not hrp then return false end

    pcall(function()
        if hum then
            hum.Sit = false
            hum.PlatformStand = false
            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
        end
    end)

    local targetCFrame = CFrame.new(targetPos.X, targetPos.Y + 3, targetPos.Z)
    local distance = (targetPos - hrp.Position).Magnitude
    local tSpeed = math.max(50, tonumber(speed or stealSpeed) or 350)
    local duration = math.max(0.05, distance / tSpeed)

    local bv = hrp:FindFirstChild("StealTweenBV") or Instance.new("BodyVelocity")
    bv.Name = "StealTweenBV"
    bv.Velocity = Vector3.zero
    bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    bv.Parent = hrp

    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(hrp, tweenInfo, { CFrame = targetCFrame })

    local completed = false
    local conn = tween.Completed:Connect(function()
        completed = true
    end)

    tween:Play()

    local startT = os.clock()
    while not completed and not HUB.dead and (os.clock() - startT < duration + 2) do
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        task.wait(0.05)
    end

    pcall(function() conn:Disconnect() end)
    pcall(function() bv:Destroy() end)

    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero
    hrp.CFrame = targetCFrame

    pcall(function()
        if hum then
            hum.Sit = false
            hum.PlatformStand = false
            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
            task.defer(function()
                if hum and hum.Parent then
                    hum:ChangeState(Enum.HumanoidStateType.Running)
                end
            end)
        end
    end)

    return true
end

local function StealOnce()
    local chr = LocalPlayer.Character
    if not chr or not chr.Parent then return false, "no character" end

    local hrp = chr:FindFirstChild("HumanoidRootPart")
    if not hrp then return false, "no humanoid root" end
    local hum = chr:FindFirstChildOfClass("Humanoid")
    if not hum then return false, "no humanoid" end

    if hum.Health <= 0 then return false, "humanoid dead" end
    pcall(function()
        hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)
        hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
    end)

    SetStealTreadmillHidden(true)

    local ok, r1 = pcall(function()
        local baitFolder = FindBaitEggSlot()
        if not baitFolder then error("EXIT:bait egg slot not found") end
        local baitPos = GetSlotPosition(baitFolder)
        if not baitPos then error("EXIT:bait egg position not found") end

        -- 1. TP to bait egg
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        hrp.CFrame = CFrame.new(baitPos + Vector3.new(0, 2.5, 0))
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        task.wait(0.1)

        -- 2. Pick it up (make sure we actually grab/hold it!)
        if Library and Library.Notify then
            Library:Notify("Auto Steal: Picking up bait egg (" .. tostring(baitFolder.Name) .. ")...")
        end
        fireEggPickup(baitFolder, baitPos)

        local baitT0 = os.clock()
        while not HUB.dead and (os.clock() - baitT0 < 1.5) do
            if IsCarryingEgg() then break end
            fireEggPickup(baitFolder, baitPos)
            task.wait(0.08)
        end

        -- 3. Wait for chicken to ragdoll the character
        if Library and Library.Notify then
            Library:Notify("Auto Steal: Holding bait — waiting for chicken to ragdoll...")
        end
        local wasRagdolled = WaitForChickenRagdoll(ragdollTimeout)

        -- 4. AT THE SAME TIME: Instant TP to another egg & pick it up!
        local targetEgg = FindTargetEgg(baitFolder)
        if not targetEgg or not targetEgg.Position then
            error("EXIT:no target egg found")
        end

        if Library and Library.Notify then
            Library:Notify("Auto Steal: Chicken hit! Snapping to " .. tostring(targetEgg.Category or "egg") .. "...")
        end

        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        hrp.CFrame = CFrame.new(targetEgg.Position + Vector3.new(0, 2.5, 0))
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero

        fireEggPickup(targetEgg.Folder, targetEgg.Position)

        local carried = false
        local carryT0 = os.clock()
        while not carried and not HUB.dead and (os.clock() - carryT0 < 1.5) do
            if IsCarryingEgg() then
                carried = true
                break
            end
            fireEggPickup(targetEgg.Folder, targetEgg.Position)
            task.wait(0.08)
        end

        -- 5. Tween back to base!
        local base = GetBasePos()
        if Library and Library.Notify then
            Library:Notify("Auto Steal: Carrying egg! Tweening back to base...")
        end

        if returnMethod == "Instant TP" then
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
            hrp.CFrame = CFrame.new(base.X, base.Y + 3, base.Z)
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        else
            TweenToBase(base, stealSpeed)
        end

        -- Stand up / clear ragdoll at base
        pcall(function()
            hum.Sit = false
            hum.PlatformStand = false
            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
            task.defer(function()
                if hum and hum.Parent then
                    hum:ChangeState(Enum.HumanoidStateType.Running)
                end
            end)
        end)

        -- 6. Verify claim / drop-off
        local claimed = false
        local claimT0 = os.clock()
        local eggUid = targetEgg.Uid
        while not claimed and not HUB.dead and (os.clock() - claimT0 < 5) do
            task.wait(0.2)
            local s = GetSave()
            if s and s.EggInventory and eggUid and s.EggInventory[eggUid] ~= nil then
                claimed = true
                break
            end
            if not IsCarryingEgg() then
                claimed = true
                break
            end
        end

        if claimed then
            error("EXIT:OK:" .. tostring(targetEgg.Category or "Egg"))
        end

        error("EXIT:Egg drop-off completed")
    end)

    if not ok then
        local msg = tostring(r1)
        if msg:sub(1, 5) == "EXIT:" then
            local exitMsg = msg:sub(6)
            if exitMsg:sub(1, 3) == "OK:" then return true, exitMsg:sub(4) end
            return false, exitMsg
        end
        return false, msg
    end
    return false, "unexpected"
end

