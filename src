    local remote = remotes and remotes.EggCarry
    if not remote and networkFolder then
        remote = networkFolder:FindFirstChild(EGG_CARRY_REMOTE)
    end
    if remote then
        task.spawn(function()
            pcall(function() remote:InvokeServer({ FirstAreaSlotKey = slotKey, Uid = folderName }) end)
        end)
    end
end

