local function getAllEggSlotsSorted(basePosition, sortMode)
    local areaFolder = workspace:FindFirstChild("AreaEggSlotsClient")
    if not areaFolder then return {} end

    local eggList = {}
    for _, slotFolder in ipairs(areaFolder:GetChildren()) do
        local partUnion = slotFolder:FindFirstChild("Part_Union") or slotFolder:FindFirstChildWhichIsA("BasePart")
        if partUnion and partUnion:IsA("BasePart") then
            table.insert(eggList, { 
                Folder = slotFolder, 
                Part = partUnion, 
                Distance = (partUnion.Position - basePosition).Magnitude 
            })
        end
    end

    table.sort(eggList, function(a, b)
        if sortMode == "Closest" then
            return a.Distance < b.Distance
        else
            return a.Distance > b.Distance
        end
    end)
    return eggList
end

