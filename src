local function toggleXRay(enabled)
    xrayEnabled = enabled
    if enabled then
        local char = charCache.character
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") and obj.Name ~= "Terrain" then
                if not char or not obj:IsDescendantOf(char) then
                    if not xrayOriginalTransparencies[obj] then
                        xrayOriginalTransparencies[obj] = obj.Transparency
                    end
                    obj.Transparency = 0.5
                end
            end
        end
    else
        for obj, trans in pairs(xrayOriginalTransparencies) do
            if obj and obj.Parent then obj.Transparency = trans end
        end
        table.clear(xrayOriginalTransparencies)
    end
end

local function toggleHidePets(enabled)
    local clientRenderedAssets = workspace:FindFirstChild("ClientRenderedAssets")
    if not enabled then
        for part, trans in pairs(originalPetTransparencies) do if part and part.Parent then part.Transparency = trans end end
        table.clear(originalPetTransparencies)
        return
    end

    table.clear(originalPetTransparencies)
    if clientRenderedAssets then
        for _, child in ipairs(clientRenderedAssets:GetDescendants()) do
            if child:IsA("BasePart") then
                originalPetTransparencies[child] = child.Transparency
                child.Transparency = 1
            end
        end
    end
end

local function toggleHideEggs(enabled)
    local eggFolders = {workspace:FindFirstChild("AreaEggSlotsClient"), workspace:FindFirstChild("Plots"), workspace:GetChildren()[18], workspace:FindFirstChild("PlacedEggRenders")}
    if not enabled then
        for part, trans in pairs(originalEggTransparencies) do if part and part.Parent then part.Transparency = trans end end
        table.clear(originalEggTransparencies)
        return
    end

    table.clear(originalEggTransparencies)
    for _, folder in ipairs(eggFolders) do
        if folder then
            for _, child in ipairs(folder:GetDescendants()) do
                if child:IsA("BasePart") and child.Name == "Part_Union" then
                    originalEggTransparencies[child] = child.Transparency
                    child.Transparency = 1
                end
            end
        end
    end
end

local function toggleESP(enabled, tableRef, espName, color, searchFolders, filterFunc)
    if not enabled then
        for _, h in ipairs(tableRef) do if h then h:Destroy() end end
        table.clear(tableRef)
        return
    end

    for _, folder in ipairs(searchFolders) do
        if folder then
            for _, child in ipairs(folder:GetDescendants()) do
                if filterFunc(child) then
                    local h = Instance.new("Highlight")
                    h.Name = espName
                    h.FillColor = color
                    h.OutlineColor = color
                    h.FillTransparency = 0.3
                    h.OutlineTransparency = 0
                    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    h.Parent = child
                    table.insert(tableRef, h)
                end
            end
        end
    end
end

