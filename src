    local gy = hrp.Position.Y
    local reachedGate = FastWalk(Vector3.new(546, gy, -370), 12, 2)
    local crossed = reachedGate and FastWalk(Vector3.new(585, gy, -366), 12, 2)
    crossed = crossed and hrp.Parent and hrp.Position.X > 570

    if wasFake then SetFakeDeath(true) end
    return crossed == true
end

